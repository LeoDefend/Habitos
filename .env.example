# =============================================================================
# .env.example — Plantilla de configuración del bot (TESTNET / PAPER TRADING)
# Copia este archivo a `.env` y rellena tus claves:
#     Windows : copy .env.example .env
#     Unix/Mac: cp .env.example .env
# NUNCA subas el archivo `.env` a git (ya está excluido en .gitignore).
# =============================================================================

# ---------------------------- Credenciales TESTNET ---------------------------
# Binance USD-M Futures Testnet: https://testnet.binancefuture.com  (usa EXCHANGE_ID=binanceusdm)
# Binance Spot Testnet:          https://testnet.binance.vision     (usa EXCHANGE_ID=binance)
API_KEY=tu_api_key_de_testnet_aqui
API_SECRET=tu_api_secret_de_testnet_aqui

# ---------------------------- Exchange / Mercado -----------------------------
# binanceusdm = futuros USD-M | binance = spot | (cualquier otro id soportado por ccxt)
EXCHANGE_ID=binance
# Par de trading. El sufijo ":USDT" indica contrato perpetuo (futuros).
SYMBOL=BTC/USDT
# Temporalidad de las velas: 1m, 5m, 15m, 1h, 4h, 1d...
TIMEFRAME=5m

# ---------------------------------- Riesgo -----------------------------------
# % máximo del capital arriesgado en UNA operación (position sizing)
RISK_PER_TRADE_PCT=1.0
# % de pérdida acumulada en el día que BLOQUEA el bot, cierra todo y alerta
MAX_DAILY_DRAWDOWN_PCT=2.0
# Stop-Loss obligatorio (% desde el precio de entrada, según dirección)
STOP_LOSS_PCT=1.0
# Take-Profit obligatorio (% desde el precio de entrada, según dirección)
TAKE_PROFIT_PCT=2.0
# Tope duro: notional máximo por operación como % del capital
MAX_NOTIONAL_PCT_OF_EQUITY=50.0
# Máximo de posiciones abiertas simultáneas en el mismo par
MAX_CONCURRENT_POSITIONS=1

# Stop-Loss y Take-Profit dinámicos basados en ATR (opcional)
USE_ATR_SL_TP=false
ATR_PERIOD=14
ATR_SL_MULT=1.5
ATR_TP_MULT=3.0

# -------------------------------- Estrategias --------------------------------
# Selección de estrategia: "sma_crossover" | "rsi" | "macd"
STRATEGY_NAME=sma_crossover

# Cruce de medias móviles simples (SMA). Regla: fast DEBE ser menor que slow.
SMA_FAST=9
SMA_SLOW=21

# Configuración de RSI (Relative Strength Index)
RSI_PERIOD=14
RSI_OVERBOUGHT=70.0
RSI_OVERSOLD=30.0

# Configuración de MACD (Moving Average Convergence Divergence)
MACD_FAST=12
MACD_SLOW=26
MACD_SIGNAL=9

# -------------------------------- Operación ----------------------------------
# Segundos entre ciclos de lectura de mercado
POLL_INTERVAL_SECONDS=60
# Anti -1021 (timestamp fuera de recvWindow): margen del timestamp en ms (Binance admite máx. 60000)
RECV_WINDOW_MS=60000
# Anti -1021: re-sincronización periódica del reloj local con el exchange (segundos)
CLOCK_RESYNC_SECONDS=1800
# Segundos de espera tras cada entrada (evita re-entradas inmediatas tras un SL)
ENTRY_COOLDOWN_SECONDS=300
# true = testnet/demo (obligatorio para paper trading)
TESTNET=true
# A qué endpoint de pruebas apuntar (IMPORTANTE en Binance: cada portal emite claves distintas):
#   auto    = enable_demo_trading si existe, si no set_sandbox_mode (por defecto)
#   sandbox = testnet.binance.vision / testnet.binancefuture.com (claves de esos portales)
#   demo    = demo-api.binance.com (claves de demo.binance.com)
TESTNET_MODE=auto
# Doble llave de seguridad: solo si AMBAS son false/true respectivamente se opera real
ALLOW_LIVE=false
# Opcional: webhook de Slack/Discord para alertas de riesgo (recibe JSON)
ALERT_WEBHOOK_URL=
# Archivo de log (vacío = solo consola)
LOG_FILE=bot.log

# ------------------------ Grid Bot (grid_bot.py) -----------------------------
# Par de la lista blanca: SOL/USDT | LINK/USDT | ADA/USDT | AVAX/USDT
GRID_SYMBOL=SOL/USDT
# Celdas solicitadas (8-12; se autocapan al máximo factible con 40 USDT y min. 5 USDT/orden)
GRID_LEVELS=8
# Ancho de celda en porcentaje (0.8 - 1.2; debe superar las comisiones 0.1%+0.1%)
GRID_SPACING_PCT=1.0
